generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Supabase Auth remains the authentication source.
// This User model represents the CRM application user and can later be mapped
// to Supabase Auth with an authUserId field when the auth-domain bridge is added.

enum UserRole {
  ADMIN
  EDITOR
  OPERATOR
  LAWYER
  MARKETING
  READ_ONLY
}

enum ClaimStatus {
  NEW
  AWAITING_VERIFICATION
  MISSING_DATA
  QUALIFIED
  DOCUMENTS_GENERATED
  ASSIGNMENT_SIGNED
  DEMAND_LETTER_PREPARED
  DEMAND_LETTER_SENT
  AWAITING_AIRLINE_RESPONSE
  NEGATIVE_RESPONSE
  COURT_DECISION_PENDING
  COURT_STAGE
  WON
  SETTLEMENT
  CLOSED_PAID
  REJECTED
  DISMISSED
}

enum ClaimType {
  DELAY
  CANCELLATION
  DENIED_BOARDING
}

enum ClaimSource {
  WEBSITE_FORM
  CHECKER_FORM
  MANUAL
  IMPORT
}

enum CommissionModel {
  STANDARD_30
  COURT_40
}

enum FlightStatus {
  SCHEDULED
  ACTIVE
  LANDED
  CANCELLED
  DIVERTED
  UNKNOWN
}

enum ClaimAmountCategory {
  EUR_250
  EUR_400
  EUR_600
}

enum DocumentType {
  ASSIGNMENT_AGREEMENT
  POWER_OF_ATTORNEY
  DEMAND_LETTER
  NEGATIVE_RESPONSE_REPLY
  LAWSUIT
  SETTLEMENT_CONFIRMATION
  CLIENT_CONFIRMATION
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
  ARCHIVED
}

enum AttachmentType {
  BOARDING_PASS
  BOOKING_CONFIRMATION
  ID_DOCUMENT
  CORRESPONDENCE
  COURT_DOCUMENT
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NoteType {
  INTERNAL
  OUTGOING_CORRESPONDENCE
  INCOMING_CORRESPONDENCE
  PHONE_CALL
  ESCALATION
}

enum SettlementStatus {
  PENDING
  RECEIVED
  CLIENT_PAID
  COMPLETED
}

enum ApiDataSource {
  AVIATION_STACK
  AERO_DATA_BOX
  MANUAL
  CACHE
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  PENDING
}

enum NewsletterEmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

model User {
  id          String    @id @default(cuid())
  authUserId  String?   @unique
  email       String    @unique
  name        String
  role        UserRole  @default(OPERATOR)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownedClaims        Claim[]              @relation("ClaimOwner")
  createdClaims      Claim[]              @relation("ClaimCreator")
  notes              Note[]
  tasks              Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  statusHistory      ClaimStatusHistory[]
  assignmentHistory  AssignmentHistory[]  @relation("ChangedBy")
  generatedDocuments Document[]
  blogPosts          BlogPost[]
  newsletterCampaigns NewsletterCampaign[]
  newsletterSegments  NewsletterSegment[]
  newsletterTemplates NewsletterTemplate[]

  @@index([email])
  @@index([authUserId])
  @@index([role, isActive])
}

model Client {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  phone            String?
  nationality      String?
  address          String?
  postalCode       String?
  city             String?
  country          String   @default("PL")
  idDocumentNumber String?
  status           String   @default("ACTIVE")
  marketingConsent Boolean  @default(false)
  emailValid       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  claims     Claim[]
  passengers Passenger[]

  @@index([email])
  @@index([lastName, firstName])
  @@index([marketingConsent, emailValid])
}

model Airline {
  id               String   @id @default(cuid())
  name             String
  iataCode         String   @unique
  country          String?
  carrierType      String?
  contactInfo      String?
  operationalNotes String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flights Flight[]
  claims  Claim[]

  @@index([iataCode])
}

model Flight {
  id                   String               @id @default(cuid())
  flightNumber         String
  flightDate           DateTime
  departureAirportCode String
  arrivalAirportCode   String
  departureCountry     String?
  arrivalCountry       String?
  scheduledDeparture   DateTime?
  actualDeparture      DateTime?
  scheduledArrival     DateTime?
  actualArrival        DateTime?
  delayMinutes         Int?
  flightStatus         FlightStatus         @default(UNKNOWN)
  distanceKm           Int?
  amountCategory       ClaimAmountCategory?
  dataSource           ApiDataSource        @default(MANUAL)
  externalApiId        String?
  rawApiResponse       Json?
  lastApiRefreshAt     DateTime?
  airlineId            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  airline Airline @relation(fields: [airlineId], references: [id])
  claims  Claim[]

  @@unique([flightNumber, flightDate])
  @@index([flightNumber])
  @@index([flightDate])
  @@index([airlineId])
}

model Claim {
  id                   String          @id @default(cuid())
  claimNumber          String          @unique
  type                 ClaimType
  source               ClaimSource     @default(WEBSITE_FORM)
  status               ClaimStatus     @default(NEW)
  subStatus            String?
  ownerId              String?
  creatorId            String
  clientId             String
  flightId             String?
  airlineId            String?
  potentialAmount      Decimal?        @db.Decimal(10, 2)
  estimatedFee         Decimal?        @db.Decimal(10, 2)
  commissionModel      CommissionModel @default(STANDARD_30)
  isCourtStage         Boolean         @default(false)
  isPolishJurisdiction Boolean         @default(true)
  dataCompleteness     Int             @default(0)
  qualifiedAt          DateTime?
  closedAt             DateTime?
  closeReason          String?
  airlinePaid          Boolean   @default(false)
  airlinePaidAt        DateTime?
  clientPaid           Boolean   @default(false)
  clientPaidAt         DateTime?
  clientIban           String?
  transferTitle        String?
  clientSettled        Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  owner   User?    @relation("ClaimOwner", fields: [ownerId], references: [id])
  creator User     @relation("ClaimCreator", fields: [creatorId], references: [id])
  client  Client   @relation(fields: [clientId], references: [id])
  flight  Flight?  @relation(fields: [flightId], references: [id])
  airline Airline? @relation(fields: [airlineId], references: [id])

  passengers        Passenger[]
  documents         Document[]
  attachments       Attachment[]
  notes             Note[]
  tasks             Task[]
  statusHistory     ClaimStatusHistory[]
  assignmentHistory AssignmentHistory[]
  payouts           Payout[]

  @@index([claimNumber])
  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status, ownerId])
}

model Passenger {
  id               String    @id @default(cuid())
  claimId          String
  clientId         String?
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  relationToClient String?
  isPrimary        Boolean   @default(false)
  hasSignedDocs    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  claim  Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])

  @@index([claimId])
}

model Document {
  id            String         @id @default(cuid())
  claimId       String
  generatedById String
  type          DocumentType
  fileName      String
  version       Int            @default(1)
  status        DocumentStatus @default(GENERATED)
  storageKey    String
  isSigned      Boolean        @default(false)
  signedAt      DateTime?
  generatedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  claim       Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  generatedBy User  @relation(fields: [generatedById], references: [id])

  @@index([claimId])
  @@index([type])
}

model Attachment {
  id                 String         @id @default(cuid())
  claimId            String
  uploadedById       String
  type               AttachmentType @default(OTHER)
  fileName           String
  mimeType           String
  sizeBytes          Int
  storageKey         String
  verificationStatus String         @default("PENDING")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([uploadedById])
}

model Note {
  id         String   @id @default(cuid())
  claimId    String
  authorId   String
  content    String   @db.Text
  type       NoteType @default(INTERNAL)
  visibility String   @default("TEAM")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  claim  Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([claimId])
  @@index([claimId, type])
}

model Task {
  id          String       @id @default(cuid())
  claimId     String
  assigneeId  String?
  creatorId   String
  title       String
  description String?      @db.Text
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  claim    Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User  @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([claimId])
  @@index([assigneeId, status])
  @@index([dueDate, status])
}

model ClaimStatusHistory {
  id          String      @id @default(cuid())
  claimId     String
  changedById String
  oldStatus   ClaimStatus
  newStatus   ClaimStatus
  comment     String?
  createdAt   DateTime    @default(now())

  claim     Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@index([claimId])
  @@index([createdAt])
}

model AssignmentHistory {
  id              String   @id @default(cuid())
  claimId         String
  changedById     String
  previousOwnerId String?
  newOwnerId      String?
  createdAt       DateTime @default(now())

  claim     Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  changedBy User  @relation("ChangedBy", fields: [changedById], references: [id])

  @@index([claimId])
}

model Payout {
  id              String           @id @default(cuid())
  claimId         String
  amountRecovered Decimal          @db.Decimal(10, 2)
  currency        String           @default("EUR")
  receivedAt      DateTime
  owemeFee        Decimal          @db.Decimal(10, 2)
  commissionModel CommissionModel
  clientAmount    Decimal          @db.Decimal(10, 2)
  clientPaidAt    DateTime?
  status          SettlementStatus @default(PENDING)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([status])
}

model CheckerEvent {
  id           String    @id @default(cuid())
  flightNumber String
  flightDate   DateTime?
  result       String
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  content         String         @db.Text
  excerpt         String         @default("") @db.Text
  category        String
  tags            String         @default("")
  authorName      String
  authorRole      String         @default("Redakcja OWEME")
  authorBio       String         @default("") @db.Text
  imageAlt        String         @default("")
  focusKeyword    String         @default("")
  metaTitle       String         @default("")
  metaDescription String         @default("")
  ogTitle         String         @default("")
  ogDescription   String         @default("")
  canonicalUrl    String         @default("")
  noindex         Boolean        @default(false)
  readTime        Int            @default(0)
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model NewsletterSubscriber {
  id                String                     @id @default(cuid())
  email             String                     @unique
  firstName         String?
  lastName          String?
  status            NewsletterSubscriberStatus @default(PENDING)
  source            String?
  tags              String[]                   @default([])
  subscribedAt      DateTime?
  unsubscribedAt    DateTime?
  unsubscribeReason String?
  lastOpenAt        DateTime?
  openCount         Int                        @default(0)
  preferences       Json                       @default("{}")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSegment {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  rules            Json     @default("[]")
  rootOperator     String   @default("AND")
  isDynamic        Boolean  @default(true)
  isSystem         Boolean  @default(false)
  recipientCount   Int?
  lastCalculatedAt DateTime?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy User                 @relation(fields: [createdById], references: [id])
  campaigns NewsletterCampaign[]

  @@index([createdById])
  @@index([isSystem])
}

model NewsletterTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  thumbnailUrl String?
  contentHtml  String   @db.Text
  isSystem     Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?                @relation(fields: [createdById], references: [id])
  campaigns NewsletterCampaign[]

  @@index([isSystem])
}

model NewsletterCampaign {
  id             String                   @id @default(cuid())
  name           String
  status         NewsletterCampaignStatus @default(DRAFT)
  subject        String
  previewText    String?
  fromName       String?
  fromEmail      String?
  replyTo        String?
  segmentId      String?
  recipientIds   String[]                 @default([])
  recipientCount Int                      @default(0)
  contentHtml    String?                  @db.Text
  contentText    String?                  @db.Text
  templateId     String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  createdBy User                @relation(fields: [createdById], references: [id])
  segment   NewsletterSegment?  @relation(fields: [segmentId], references: [id])
  template  NewsletterTemplate? @relation(fields: [templateId], references: [id])
  emailLogs NewsletterEmailLog[]
  linkClicks NewsletterLinkClick[]

  @@index([status])
  @@index([segmentId])
  @@index([createdById])
  @@index([scheduledAt])
}

model NewsletterEmailLog {
  id             String                @id @default(cuid())
  campaignId     String
  recipientEmail String
  recipientName  String?
  status         NewsletterEmailStatus
  messageId      String?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  bounceType     String?
  errorMessage   String?               @db.Text
  sentAt         DateTime?
  createdAt      DateTime              @default(now())

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientEmail])
  @@index([status])
}

model NewsletterLinkClick {
  id             String   @id @default(cuid())
  campaignId     String
  recipientEmail String
  originalUrl    String   @db.Text
  trackingUrl    String
  clickedAt      DateTime @default(now())
  userAgent      String?  @db.Text
  ipAddress      String?

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientEmail])
}
