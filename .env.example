# Database
# Production on Vercel should use the Supabase transaction pooler URL.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Direct/session connection used by Prisma schema operations and migrations.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Future server-only integrations
AVIATIONSTACK_API_KEY=
AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
USE_FLIGHT_API_MOCK=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=
STORAGE_BUCKET_NAME=
INTERNAL_API_SECRET=

# E2E only - use a separate non-production database and test auth account.
E2E_DATABASE_URL=
OWEME_E2E_EMAIL=
OWEME_E2E_PASSWORD=
