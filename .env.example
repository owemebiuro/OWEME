# Database
# Production on Vercel should use the Supabase transaction pooler URL.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Direct/session connection used by Prisma schema operations and migrations.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Optional comma-separated allowlist for bootstrapping admin users when CRM users already exist.
OWEME_BOOTSTRAP_ADMIN_EMAILS=

# Flight data
FLIGHTAWARE_AEROAPI_KEY=
FLIGHTAWARE_AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_AEROAPI_TIMEOUT_MS=10000
FLIGHT_DATA_CACHE_TTL_HOURS=6
USE_FLIGHT_API_MOCK=false
# Cloudflare R2
# If `R2_ENDPOINT` is empty, the app will build it automatically from `R2_ACCOUNT_ID`
# as `https://<account-id>.r2.cloudflarestorage.com`.
# In local development, server-side document generation can fall back to `.dev-storage/`
# when R2 is not configured. Restart `npm run dev` after changing `.env.local`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=

# E2E only - use a separate non-production database and test auth account.
E2E_DATABASE_URL=
OWEME_E2E_EMAIL=
OWEME_E2E_PASSWORD=
